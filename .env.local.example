# 复制此文件为 .env.local 并填入你的 API key

# 阿里云百炼（通义千问）—— 国内卡即可支付，默认配置
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-plus

# 备选模型（在百炼控制台开通后使用）：
#   qwen3.7-plus   —— 首选：高精度 OCR + 文档解析 + 结构化输出
#   qwen3-vl-plus  —— 视觉语言模型（如果 qwen3.7-plus 用不了换这个）
#   qwen3.8-max    —— 最强旗舰，但贵，没必要

# 如果换 OpenAI：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===== Supabase（登录 + 每日用量限制）=====
# 去 https://supabase.com 建项目，Project Settings → API 里拿下面两个值
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===== 站点正式域名（邮箱确认链接重定向用）=====
# 线上部署必填，否则邮箱确认链接会重定向到内部地址
NEXT_PUBLIC_SITE_URL=https://statementexcelconverter.com
